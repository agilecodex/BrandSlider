/** @var \Acx\BrandSlider\Block\BrandSlider $block */
$htmlId = $block->getFlexSliderHtmlId();
$brandCollection = $block->getBrandCollection();
?>
<link rel="stylesheet" type="text/css"
      href="<?= $block->getViewFileUrl('Acx_BrandSlider::css/slick.css') ?>">
<div class="slick-list">
    <?php if ($block->getData("show_title")) : ?>
        <h2><?= $block->getTitle() ?></h2>
    <?php endif; ?>
    <ul class="brand-list">
        <?php foreach ($brandCollection as $brand) : ?>
            <li data-thumb="<?= $block->getBrandImageUrl($brand) ?>">
                <img alt="<?= $brand->getImageAlt() ?>"
                     src="<?= $block->getBrandImageUrl($brand) ?>"/>
                <?php if ($brand->getName() && $block->getShowCaption()) :?>
                    <span><?= $brand->getName() ?></span>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
</div>

<script type="text/javascript">
    require([
        'jquery',
        'slick',
        'domReady!'
    ], function ($) {
        $('.brand-list').slick({
            dots: <?= (!$block->getDot()) ? "false" : "true" ?>,
            infinite: <?= (!$block->getInfinite()) ? "false" : "true" ?>,
            speed: <?= $block->getBrandsliderSpeed() ?>,
            slidesToShow: <?= $block->getSlidesToShow() ? $block->getSlidesToShow() : 5 ?>,
            slidesToScroll: <?= $block->getSlidesToScroll() ? $block->getSlidesToScroll() : 2 ?>,
            responsive: [
                {
                    breakpoint: 1024,
                    settings: {
                        slidesToShow: <?= $block->getSlidesToShow() ? $block->getSlidesToShow() : 4 ?>,
                        slidesToScroll: <?= $block->getSlidesToScroll() ? $block->getSlidesToScroll() : 2 ?>,
                        infinite: <?= (!$block->getInfinite()) ? "false" : "true" ?>,
                        dots: <?= (!$block->getDot()) ? "false" : "true" ?>,
                    }
                },
                {
                    breakpoint: 600,
                    settings: {
                        slidesToShow: 3,
                        slidesToScroll: 3
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 2,
                        slidesToScroll: 2
                    }
                }
            ]
        });
    });
</script>
