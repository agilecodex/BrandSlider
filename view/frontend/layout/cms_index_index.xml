<?xml version="1.0"?>
<!--
    Display the configured Acx BrandSlider on the storefront homepage.
    Brands remain managed through AgileCodex > Brand Management.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Acx\BrandSlider\Block\BrandSlider"
                   name="acx.home.brand.slider"
                   template="Acx_BrandSlider::widget/brandslider.phtml"
                   before="-">
                <arguments>
                    <argument name="show_title" xsi:type="boolean">true</argument>
                    <argument name="title" xsi:type="string" translate="true">Featured Brands</argument>
                    <argument name="show_caption" xsi:type="boolean">false</argument>
                    <argument name="dot" xsi:type="boolean">false</argument>
                    <argument name="infinite" xsi:type="boolean">true</argument>
                    <argument name="brandslider_speed" xsi:type="number">400</argument>
                    <argument name="autoplay" xsi:type="boolean">true</argument>
                    <argument name="autoplaySpeed" xsi:type="number">3500</argument>
                    <argument name="slides_to_show" xsi:type="number">5</argument>
                    <argument name="slides_to_scroll" xsi:type="number">1</argument>
                    <argument name="slides_to_show_tab" xsi:type="number">4</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
